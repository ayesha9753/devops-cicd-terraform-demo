aws_region       = "us-east-1"
project_name     = "devops-portfolio"
environment      = "dev"
instance_type    = "t2.micro"
ami_id           = "ami-0c101f26f147fa7fd" # Amazon Linux 2 (us-east-1) - verify latest AMI ID
key_pair_name    = "your-ec2-keypair-name"
allowed_ssh_cidr = "YOUR.IP.ADDRESS.HERE/32"
app_port         = 3000
docker_image     = "yourdockerhub-username/devops-portfolio-api:latest"
